# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real one stays out of the repository.
.env*
# ...except the reference, which contains no values and documents what is needed.
!.env.example

# Docker / deploy artefacts that must not be committed
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
