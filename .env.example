# =============================================================================
# Elite Algos Labs — environment reference
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development, or `.env.production` on the server.
# NEITHER FILE IS EVER COMMITTED — both are in .gitignore. Verify with:
#   git check-ignore -v .env.production
# =============================================================================

# --- Public -------------------------------------------------------------------
# Baked into the client bundle at BUILD time, so it must be set before
# `npm run build` (and passed as a Docker build arg). Used for canonical URLs,
# hreflang alternates, Open Graph and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://elitealgoslabs.com

# --- Secrets — runtime only, never build args --------------------------------
# Signs the admin session JWT. Minimum 32 characters; the app refuses to start
# without it rather than falling back to a default.
#   openssl rand -base64 48
AUTH_SECRET=

# Operator accounts for the command center.
#   Format:  email|Full Name|role|salt:hash
#   Multiple accounts separated by `;`
#   Roles:   founder | administrator | developer | marketing | editor | readonly
#
# Generate the hash (note the leading space to keep it out of shell history):
#    node scripts/hash-password.mjs 'your-password'
#
# Example (hash truncated):
#   ADMIN_ACCOUNTS="founder@elitealgoslabs.com|R. Founder|founder|a1b2c3…:d4e5f6…"
#
# Leaving this empty means NOBODY can sign in — which is the correct default.
# No account ships with the application.
ADMIN_ACCOUNTS=

# --- Optional integrations ----------------------------------------------------
# GitHub activity module. Scope to `read:org` and `repo`. Server-side only —
# never rename with a NEXT_PUBLIC_ prefix, which would ship it to the browser.
GITHUB_TOKEN=
GITHUB_ORG=EliteAlgosLabs
